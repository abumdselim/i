// The deployed studio (D-21): OpenNext runs the Next.js app on Workers, the
// middleware is the gate, and the repository is the store. Secrets
// (GITHUB_TOKEN, STUDIO_SESSION_SECRET, STUDIO_PASSWORD_SHA256) are set with
// `wrangler secret put` — never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
